{
  "name": "angular-through-time",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "node --test packages/market-fixtures/*.test.cjs benchmark/harness/*.test.mjs benchmark/v2/*.test.mjs",
    "build": "node scripts/build.mjs",
    "bench": "node benchmark/harness/run.mjs",
    "summarize": "node benchmark/harness/summarize.mjs",
    "serve": "node scripts/serve.mjs",
    "research:generate": "node scripts/generate-research.mjs",
    "research:build": "node scripts/build-research.mjs",
    "research:verify": "node benchmark/v2/verify.mjs",
    "research:audit": "node benchmark/v2/audit.mjs --check",
    "research:evidence": "node scripts/verify-evidence.mjs",
    "research:pilot": "node benchmark/v2/pilot.mjs"
  },
  "devDependencies": {
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "playwright": "1.64.1",
    "puppeteer-core": "25.14.0"
  }
}
