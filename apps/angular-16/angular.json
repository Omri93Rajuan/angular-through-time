{
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "baseline": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/baseline",
            "index": "src/index.html",
            "main": "src/baseline.ts",
            "tsConfig": "tsconfig.baseline.json",
            "scripts": [
              "src/engine.js"
            ],
            "styles": [
              "src/styles.css"
            ],
            "assets": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "aot": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "idiomatic": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/idiomatic",
            "index": "src/index.html",
            "main": "src/idiomatic.ts",
            "tsConfig": "tsconfig.idiomatic.json",
            "scripts": [
              "src/engine.js"
            ],
            "styles": [
              "src/styles.css"
            ],
            "assets": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "aot": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
