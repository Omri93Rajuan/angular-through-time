{
  "schemaVersion": 2,
  "kind": "native-install",
  "version": {
    "major": 19,
    "angular": "19.2.15",
    "cli": "19.2.19",
    "typescript": "5.8.3",
    "node": "22.23.2",
    "zone": "0.15.1"
  },
  "cache": "install",
  "accepted": true,
  "exitCode": 0,
  "durationMs": 15688.430133999995,
  "command": [
    "install",
    "--engine-strict",
    "--no-audit",
    "--no-fund"
  ],
  "builder": "@angular-devkit/build-angular:application",
  "configuration": {
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
      "market-native": {
        "projectType": "application",
        "schematics": {},
        "root": "",
        "sourceRoot": "src",
        "prefix": "app",
        "architect": {
          "build": {
            "builder": "@angular-devkit/build-angular:application",
            "options": {
              "outputPath": "dist/market-native",
              "index": "src/index.html",
              "browser": "src/main.ts",
              "polyfills": [
                "zone.js"
              ],
              "tsConfig": "tsconfig.app.json",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                }
              ],
              "styles": [
                "src/styles.css"
              ],
              "scripts": [
                "src/engine.js"
              ]
            },
            "configurations": {
              "production": {
                "budgets": [
                  {
                    "type": "initial",
                    "maximumWarning": "500kB",
                    "maximumError": "1MB"
                  },
                  {
                    "type": "anyComponentStyle",
                    "maximumWarning": "4kB",
                    "maximumError": "8kB"
                  }
                ],
                "outputHashing": "all"
              },
              "development": {
                "optimization": false,
                "extractLicenses": false,
                "sourceMap": true
              }
            },
            "defaultConfiguration": "production"
          },
          "serve": {
            "builder": "@angular-devkit/build-angular:dev-server",
            "configurations": {
              "production": {
                "buildTarget": "market-native:build:production"
              },
              "development": {
                "buildTarget": "market-native:build:development"
              }
            },
            "defaultConfiguration": "development"
          },
          "extract-i18n": {
            "builder": "@angular-devkit/build-angular:extract-i18n"
          },
          "test": {
            "builder": "@angular-devkit/build-angular:karma",
            "options": {
              "polyfills": [
                "zone.js",
                "zone.js/testing"
              ],
              "tsConfig": "tsconfig.spec.json",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                }
              ],
              "styles": [
                "src/styles.css"
              ],
              "scripts": []
            }
          }
        }
      }
    }
  },
  "osCache": "uncontrolled",
  "workers": "CLI default; no worker override",
  "lockSha256": "d8fffc5876d2bbe5fb14d84f4a91779376baa0b877df86f7f5581ebf854efdc2"
}