{
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "idiomatic-v2": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/idiomatic-v2",
            "index": "src/research/index.html",
            "main": "src/research/idiomatic-v2/main.ts",
            "tsConfig": "tsconfig.idiomatic-v2.json",
            "scripts": [
              "src/engine.js"
            ],
            "styles": [
              "src/styles.css"
            ],
            "assets": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "aot": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
